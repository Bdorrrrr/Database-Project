UPDATE APPOINTMENT
SET date = '2026-07-20', status = 'Rescheduled'
WHERE appointmentID = 1;

DELETE FROM APPOINTMENT
WHERE appointmentID = 3;

SELECT A.appointmentID, P.fullName AS Patient_Name, D.name AS Doctor_Name, A.date, A.status
FROM APPOINTMENT A
JOIN PATIENT P ON A.patientID = P.patientID
JOIN DOCTOR D ON A.doctorID = D.doctorID
ORDER BY A.date ASC;

SELECT DEP.name AS Department, COUNT(DOC.doctorID) AS Total_Doctors
FROM DEPARTMENT DEP
LEFT JOIN DOCTOR DOC ON DEP.departmentID = DOC.deptID
GROUP BY DEP.name
ORDER BY Total_Doctors DESC;
